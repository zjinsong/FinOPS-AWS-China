# Copy to .env and replace every placeholder. Never commit .env.
FINOPS_ENVIRONMENT=poc
FINOPS_ACCOUNT_B_ROLE_ARN=arn:aws-cn:iam::<LINKED_ACCOUNT_B_ID>:role/FinOpsReadOnlyRole
FINOPS_ACCOUNT_B_EXTERNAL_ID=<GENERATE_A_RANDOM_EXTERNAL_ID>
FINOPS_REGIONS=cn-north-1,cn-northwest-1
FINOPS_BILLING_REGION=cn-northwest-1
FINOPS_PRICING_REGION=cn-northwest-1
FINOPS_ATHENA_REGION=cn-north-1
FINOPS_ATHENA_DATABASE=finops
FINOPS_ATHENA_WORKGROUP=finops
FINOPS_ATHENA_VIEW=cur_unified
FINOPS_QUICKSIGHT_REGION=cn-north-1
FINOPS_QUICKSIGHT_DASHBOARD_ID=<QUICKSIGHT_DASHBOARD_ID>
FINOPS_QUICKSIGHT_USER_ARN=arn:aws-cn:quicksight:cn-north-1:<CENTRAL_ACCOUNT_ID>:user/default/<REGISTERED_USER>
FINOPS_QUICKSIGHT_ALLOWED_DOMAINS=http://localhost:8080
FINOPS_DEEPSEEK_BASE_URL=https://api.deepseek.com
FINOPS_SECURE_COOKIE=false
FINOPS_SECRET_DIR=/etc/finops-ai
